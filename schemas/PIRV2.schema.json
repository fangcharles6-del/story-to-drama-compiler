{
  "$defs": {
    "CharacterAssetBinding": {
      "additionalProperties": false,
      "properties": {
        "asset_version_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Asset Version Id",
          "type": "string"
        },
        "character_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Character Id",
          "type": "string"
        },
        "schema_version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "character_id",
        "asset_version_id"
      ],
      "title": "CharacterAssetBinding",
      "type": "object"
    },
    "CreativeCameraAngle": {
      "enum": [
        "EYE_LEVEL",
        "LOW_ANGLE",
        "HIGH_ANGLE",
        "DUTCH_ANGLE",
        "OVERHEAD",
        "POV"
      ],
      "title": "CreativeCameraAngle",
      "type": "string"
    },
    "CreativeCameraMovement": {
      "enum": [
        "STATIC",
        "PAN",
        "TILT",
        "DOLLY",
        "TRUCK",
        "PEDESTAL",
        "HANDHELD",
        "CRANE",
        "ZOOM",
        "ORBIT"
      ],
      "title": "CreativeCameraMovement",
      "type": "string"
    },
    "CreativeShotSize": {
      "enum": [
        "EXTREME_CLOSE_UP",
        "CLOSE_UP",
        "MEDIUM_CLOSE_UP",
        "MEDIUM",
        "MEDIUM_WIDE",
        "WIDE",
        "EXTREME_WIDE"
      ],
      "title": "CreativeShotSize",
      "type": "string"
    },
    "StoryboardShotV2": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "camera_angle": {
          "$ref": "#/$defs/CreativeCameraAngle"
        },
        "camera_movement": {
          "$ref": "#/$defs/CreativeCameraMovement"
        },
        "character_assets": {
          "items": {
            "$ref": "#/$defs/CharacterAssetBinding"
          },
          "maxItems": 2,
          "title": "Character Assets",
          "type": "array"
        },
        "continuity_notes": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Continuity Notes",
          "type": "string"
        },
        "dialogue_line_ids": {
          "items": {
            "type": "string"
          },
          "title": "Dialogue Line Ids",
          "type": "array"
        },
        "duration_ms": {
          "exclusiveMinimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "emotion_by_character": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 2,
          "title": "Emotion By Character",
          "type": "object"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "narrative": {
          "minLength": 1,
          "title": "Narrative",
          "type": "string"
        },
        "nir_scene_id": {
          "title": "Nir Scene Id",
          "type": "string"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "prompt": {
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "props": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Props",
          "type": "array"
        },
        "scene_asset_version_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Scene Asset Version Id",
          "type": "string"
        },
        "scene_bible_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Scene Bible Id",
          "type": "string"
        },
        "schema_version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "shot_size": {
          "$ref": "#/$defs/CreativeShotSize"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "visual_direction": {
          "minLength": 1,
          "title": "Visual Direction",
          "type": "string"
        },
        "wardrobe_by_character": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 2,
          "title": "Wardrobe By Character",
          "type": "object"
        }
      },
      "required": [
        "id",
        "nir_scene_id",
        "scene_bible_id",
        "scene_asset_version_id",
        "ordinal",
        "narrative",
        "visual_direction",
        "emotion_by_character",
        "action",
        "shot_size",
        "camera_angle",
        "camera_movement",
        "wardrobe_by_character",
        "props",
        "continuity_notes",
        "prompt",
        "start_ms",
        "duration_ms",
        "character_assets",
        "dialogue_line_ids"
      ],
      "title": "StoryboardShotV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "duration_ms": {
      "maximum": 90000,
      "minimum": 60000,
      "title": "Duration Ms",
      "type": "integer"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "nir_id": {
      "title": "Nir Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "shots": {
      "items": {
        "$ref": "#/$defs/StoryboardShotV2"
      },
      "maxItems": 12,
      "minItems": 8,
      "title": "Shots",
      "type": "array"
    }
  },
  "required": [
    "id",
    "nir_id",
    "duration_ms",
    "shots"
  ],
  "title": "PIRV2",
  "type": "object"
}
