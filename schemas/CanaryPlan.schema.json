{
  "additionalProperties": false,
  "properties": {
    "approved_cost_ceiling_cny": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Approved Cost Ceiling Cny"
    },
    "attempt": {
      "const": 1,
      "default": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "capability_snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Capability Snapshot Sha256",
      "type": "string"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "planned_at": {
      "format": "date-time",
      "title": "Planned At",
      "type": "string"
    },
    "posts_allowed": {
      "const": 0,
      "default": 0,
      "title": "Posts Allowed",
      "type": "integer"
    },
    "pricing_snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Pricing Snapshot Sha256",
      "type": "string"
    },
    "request_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Fingerprint",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "const": "NOT_AUTHORIZED",
      "default": "NOT_AUTHORIZED",
      "title": "State",
      "type": "string"
    },
    "worst_case_cost_cny": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Worst Case Cost Cny"
    }
  },
  "required": [
    "run_id",
    "job_id",
    "request_fingerprint",
    "capability_snapshot_sha256",
    "pricing_snapshot_sha256",
    "worst_case_cost_cny",
    "approved_cost_ceiling_cny",
    "planned_at"
  ],
  "title": "CanaryPlan",
  "type": "object"
}
