    "critical_identity_breaks": {
      "minimum": 0,
      "title": "Critical Identity Breaks",
      "type": "integer"
    },
    "duplicate_media_count": {
      "minimum": 0,
      "title": "Duplicate Media Count",
      "type": "integer"
    },
    "failure_counts": {
      "additionalProperties": {
        "minimum": 0,
        "type": "integer"
      },
      "title": "Failure Counts",
      "type": "object"
    },
    "first_pass_usable_rate": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "First Pass Usable Rate"
    },
    "human_edit_minutes": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Human Edit Minutes"
    },
    "revision_id": {
      "pattern": "^creative_revision_[0-9a-f]{20}$",
      "title": "Revision Id",
      "type": "string"
    },
    "sample_id": {
      "pattern": "^creative_sample_[0-9a-f]{20}$",
      "title": "Sample Id",
      "type": "string"
    },
    "scene_continuity_rate": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
