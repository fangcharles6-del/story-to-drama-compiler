{
  "$defs": {
    "CreativeCameraAngle": {
      "enum": [
        "EYE_LEVEL",
        "LOW_ANGLE",
        "HIGH_ANGLE",
        "DUTCH_ANGLE",
        "OVERHEAD",
        "POV"
      ],
      "title": "CreativeCameraAngle",
      "type": "string"
    },
    "CreativeCameraMovement": {
      "enum": [
        "STATIC",
        "PAN",
        "TILT",
        "DOLLY",
        "TRUCK",
        "PEDESTAL",
        "HANDHELD",
        "CRANE",
        "ZOOM",
        "ORBIT"
      ],
      "title": "CreativeCameraMovement",
      "type": "string"
    },
    "CreativeShotSize": {
      "enum": [
        "EXTREME_CLOSE_UP",
        "CLOSE_UP",
        "MEDIUM_CLOSE_UP",
        "MEDIUM",
        "MEDIUM_WIDE",
        "WIDE",
        "EXTREME_WIDE"
      ],
      "title": "CreativeShotSize",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "ID-free source shot; compilation derives the immutable StoryboardShotV2 ID.",
  "properties": {
    "action": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Action",
      "type": "string"
    },
    "camera_angle": {
      "$ref": "#/$defs/CreativeCameraAngle"
    },
    "camera_movement": {
      "$ref": "#/$defs/CreativeCameraMovement"
    },
    "character_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 2,
      "title": "Character Ids",
      "type": "array"
    },
    "continuity_notes": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Continuity Notes",
      "type": "string"
    },
    "dialogue_line_ids": {
      "items": {
        "type": "string"
      },
      "title": "Dialogue Line Ids",
      "type": "array"
    },
    "duration_ms": {
      "exclusiveMinimum": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "emotion_by_character": {
      "additionalProperties": {
        "type": "string"
      },
      "maxProperties": 2,
      "title": "Emotion By Character",
      "type": "object"
    },
    "narrative": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Narrative",
      "type": "string"
    },
    "ordinal": {
      "minimum": 0,
      "title": "Ordinal",
      "type": "integer"
    },
    "props": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "title": "Props",
      "type": "array"
    },
    "scene_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Scene Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "shot_size": {
      "$ref": "#/$defs/CreativeShotSize"
    },
    "start_ms": {
      "minimum": 0,
      "title": "Start Ms",
      "type": "integer"
    },
    "visual_direction": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Visual Direction",
      "type": "string"
    },
    "wardrobe_by_character": {
      "additionalProperties": {
        "type": "string"
      },
      "maxProperties": 2,
      "title": "Wardrobe By Character",
      "type": "object"
    }
  },
  "required": [
    "ordinal",
    "scene_id",
    "narrative",
    "visual_direction",
    "emotion_by_character",
    "action",
    "shot_size",
    "camera_angle",
    "camera_movement",
    "wardrobe_by_character",
    "props",
    "continuity_notes",
    "start_ms",
    "duration_ms",
    "character_ids",
    "dialogue_line_ids"
  ],
  "title": "CreativeSampleShotSpec",
  "type": "object"
}
