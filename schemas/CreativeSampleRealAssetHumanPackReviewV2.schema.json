{
  "$defs": {
    "RealAssetHumanFindingV2": {
      "additionalProperties": false,
      "description": "Explicit human inspection of one exact frozen binding.",
      "properties": {
        "binding": {
          "$ref": "#/$defs/RealAssetRightsEvidenceBindingV2"
        },
        "content_role_approved": {
          "title": "Content Role Approved",
          "type": "boolean"
        },
        "exception": {
          "anyOf": [
            {
              "$ref": "#/$defs/RealAssetReviewExceptionV2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "inspection_confirmed": {
          "const": true,
          "title": "Inspection Confirmed",
          "type": "boolean"
        }
      },
      "required": [
        "binding",
        "inspection_confirmed",
        "content_role_approved"
      ],
      "title": "RealAssetHumanFindingV2",
      "type": "object"
    },
    "RealAssetReviewExceptionV2": {
      "additionalProperties": false,
      "description": "One human-authored blocking finding for a particular reviewed asset.",
      "properties": {
        "failed_gates": {
          "items": {
            "$ref": "#/$defs/RightsGateV2"
          },
          "maxItems": 7,
          "minItems": 1,
          "title": "Failed Gates",
          "type": "array"
        },
        "finding": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Finding",
          "type": "string"
        }
      },
      "required": [
        "failed_gates",
        "finding"
      ],
      "title": "RealAssetReviewExceptionV2",
      "type": "object"
    },
    "RealAssetRightsEvidenceBindingV2": {
      "additionalProperties": false,
      "description": "Mechanical identity of one member of the exact frozen fourteen-object pack.",
      "properties": {
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "IMAGE",
            "VOICE",
            "BGM"
          ],
          "title": "Kind",
          "type": "string"
        },
        "logical_path": {
          "title": "Logical Path",
          "type": "string"
        },
        "media_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Media Sha256",
          "type": "string"
        },
        "media_size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Media Size Bytes",
          "type": "integer"
        },
        "media_type": {
          "enum": [
            "image/png",
            "audio/wav"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "object_path": {
          "title": "Object Path",
          "type": "string"
        },
        "ordinal": {
          "maximum": 13,
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "provenance_record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Provenance Record Sha256",
          "type": "string"
        },
        "requirement_id": {
          "pattern": "^real_asset_requirement_[0-9a-f]{20}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "source_authority": {
          "enum": [
            "USER_PROVIDED_LOCAL",
            "SEPARATELY_APPROVED_LOCAL_GENERATION"
          ],
          "title": "Source Authority",
          "type": "string"
        },
        "subject_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Subject Id",
          "type": "string"
        },
        "technical_profile": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Technical Profile",
          "type": "string"
        },
        "technical_record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Technical Record Sha256",
          "type": "string"
        }
      },
      "required": [
        "ordinal",
        "requirement_id",
        "kind",
        "subject_id",
        "logical_path",
        "object_path",
        "media_type",
        "media_sha256",
        "media_size_bytes",
        "duration_ms",
        "source_authority",
        "provenance_record_sha256",
        "technical_profile",
        "technical_record_sha256"
      ],
      "title": "RealAssetRightsEvidenceBindingV2",
      "type": "object"
    },
    "RightsGateV2": {
      "enum": [
        "PROVENANCE",
        "COPYRIGHT",
        "LIKENESS",
        "PRIVACY",
        "TERRITORY",
        "USE_SCOPE",
        "CONTENT_ROLE"
      ],
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One complete human review of all fourteen exact frozen members.",
  "properties": {
    "copyright_approved": {
      "title": "Copyright Approved",
      "type": "boolean"
    },
    "current_gate": {
      "const": "HUMAN_GATE",
      "default": "HUMAN_GATE",
      "title": "Current Gate",
      "type": "string"
    },
    "decision": {
      "enum": [
        "APPROVED",
        "REJECTED"
      ],
      "title": "Decision",
      "type": "string"
    },
    "document_type": {
      "const": "sdc.creative-sample-real-asset-human-pack-review-v2",
      "default": "sdc.creative-sample-real-asset-human-pack-review-v2",
      "title": "Document Type",
      "type": "string"
    },
    "execution_authorized": {
      "const": false,
      "default": false,
      "title": "Execution Authorized",
      "type": "boolean"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/RealAssetHumanFindingV2"
      },
      "maxItems": 14,
      "minItems": 14,
      "title": "Findings",
      "type": "array"
    },
    "likeness_approved": {
      "title": "Likeness Approved",
      "type": "boolean"
    },
    "pack_id": {
      "pattern": "^real_asset_pack_[0-9a-f]{20}$",
      "title": "Pack Id",
      "type": "string"
    },
    "posts_allowed": {
      "const": 0,
      "default": 0,
      "title": "Posts Allowed",
      "type": "integer"
    },
    "privacy_approved": {
      "title": "Privacy Approved",
      "type": "boolean"
    },
    "profile": {
      "const": "creative-sample-real-asset-review-v2",
      "default": "creative-sample-real-asset-review-v2",
      "title": "Profile",
      "type": "string"
    },
    "provenance_approved": {
      "title": "Provenance Approved",
      "type": "boolean"
    },
    "provider_requests": {
      "const": 0,
      "default": 0,
      "title": "Provider Requests",
      "type": "integer"
    },
    "provider_state": {
      "const": "NOT_AUTHORIZED",
      "default": "NOT_AUTHORIZED",
      "title": "Provider State",
      "type": "string"
    },
    "rejection_reason": {
      "anyOf": [
        {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rejection Reason"
    },
    "review_id": {
      "pattern": "^real_asset_pack_review_v2_[0-9a-f]{20}$",
      "title": "Review Id",
      "type": "string"
    },
    "review_record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Review Record Sha256",
      "type": "string"
    },
    "reviewed_at": {
      "title": "Reviewed At",
      "type": "string"
    },
    "reviewer_ref_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Reviewer Ref Sha256",
      "type": "string"
    },
    "reviewer_role": {
      "enum": [
        "REVIEWER_A",
        "REVIEWER_B"
      ],
      "title": "Reviewer Role",
      "type": "string"
    },
    "rights_evidence_bundle_id": {
      "pattern": "^real_asset_rights_evidence_v2_[0-9a-f]{20}$",
      "title": "Rights Evidence Bundle Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "const": "REVIEW_COMPLETE",
      "default": "REVIEW_COMPLETE",
      "title": "Status",
      "type": "string"
    },
    "territory_approved": {
      "title": "Territory Approved",
      "type": "boolean"
    },
    "use_scope_approved": {
      "title": "Use Scope Approved",
      "type": "boolean"
    }
  },
  "required": [
    "review_id",
    "pack_id",
    "rights_evidence_bundle_id",
    "reviewer_role",
    "reviewer_ref_sha256",
    "review_record_sha256",
    "reviewed_at",
    "findings",
    "provenance_approved",
    "copyright_approved",
    "likeness_approved",
    "privacy_approved",
    "territory_approved",
    "use_scope_approved",
    "decision"
  ],
  "title": "CreativeSampleRealAssetHumanPackReviewV2",
  "type": "object"
}
