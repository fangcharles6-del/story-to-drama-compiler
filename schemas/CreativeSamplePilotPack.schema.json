    "PilotAssetRequirement": {
      "additionalProperties": false,
      "properties": {
        "asset_version_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Asset Version Id",
          "type": "string"
        },
        "eligible_for_real_generation": {
          "const": false,
          "default": false,
          "title": "Eligible For Real Generation",
          "type": "boolean"
        },
        "intended_logical_path": {
          "title": "Intended Logical Path",
          "type": "string"
        },
        "media_type": {
          "const": "image/png",
          "default": "image/png",
          "title": "Media Type",
          "type": "string"
        },
        "placeholder_label": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Placeholder Label",
          "type": "string"
        },
        "placeholder_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Placeholder Sha256",
          "type": "string"
        },
        "privacy_status": {
          "const": "PENDING_REVIEW",
          "default": "PENDING_REVIEW",
          "title": "Privacy Status",
          "type": "string"
        },
        "requirement_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "rights_status": {
          "const": "PENDING_REVIEW",
          "default": "PENDING_REVIEW",
          "title": "Rights Status",
          "type": "string"
        },
        "source_mode": {
          "const": "SYNTHETIC_PLACEHOLDER_ONLY",
          "default": "SYNTHETIC_PLACEHOLDER_ONLY",
          "title": "Source Mode",
          "type": "string"
        },
        "subject_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Subject Id",
          "type": "string"
        },
        "subject_kind": {
          "enum": [
            "CHARACTER",
            "SCENE"
          ],
          "title": "Subject Kind",
          "type": "string"
        },
        "submission_status": {
          "const": "NOT_SUBMITTED",
          "default": "NOT_SUBMITTED",
          "title": "Submission Status",
          "type": "string"
        },
        "visual_requirements": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Visual Requirements",
          "type": "array"
        }
      },
      "required": [
        "requirement_id",
        "subject_kind",
        "subject_id",
        "asset_version_id",
        "intended_logical_path",
        "placeholder_label",
        "placeholder_sha256",
        "visual_requirements"
      ],
      "title": "PilotAssetRequirement",
      "type": "object"
    },
    "PilotAudioRequirement": {
