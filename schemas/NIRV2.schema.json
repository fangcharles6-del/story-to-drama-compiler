          "type": "string"
        },
        "asset_versions": {
          "items": {
            "$ref": "#/$defs/CharacterAssetVersion"
          },
          "minItems": 1,
          "title": "Asset Versions",
          "type": "array"
        },
        "character_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Character Id",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "visual_description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Visual Description",
          "type": "string"
