{
  "$defs": {
    "RealAssetSubmissionItem": {
      "additionalProperties": false,
      "properties": {
        "expected_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Sha256"
        },
        "expected_size_bytes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Size Bytes"
        },
        "logical_path": {
          "title": "Logical Path",
          "type": "string"
        },
        "provenance_record_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provenance Record Sha256"
        },
        "requirement_id": {
          "pattern": "^real_asset_requirement_[0-9a-f]{20}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "source_authority": {
          "anyOf": [
            {
              "enum": [
                "USER_PROVIDED_LOCAL",
                "SEPARATELY_APPROVED_LOCAL_GENERATION"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Authority"
        },
        "status": {
          "default": "MISSING",
          "enum": [
            "MISSING",
            "SUBMITTED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "logical_path"
      ],
      "title": "RealAssetSubmissionItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "current_gate": {
      "const": "HUMAN_GATE",
      "default": "HUMAN_GATE",
      "title": "Current Gate",
      "type": "string"
    },
    "document_type": {
      "const": "sdc.creative-sample-real-asset-submission",
      "default": "sdc.creative-sample-real-asset-submission",
      "title": "Document Type",
      "type": "string"
    },
    "execution_authorized": {
      "const": false,
      "default": false,
      "title": "Execution Authorized",
      "type": "boolean"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/RealAssetSubmissionItem"
      },
      "maxItems": 14,
      "minItems": 14,
      "title": "Items",
      "type": "array"
    },
    "posts_allowed": {
      "const": 0,
      "default": 0,
      "title": "Posts Allowed",
      "type": "integer"
    },
    "profile": {
      "const": "creative-sample-real-asset-intake-v1",
      "default": "creative-sample-real-asset-intake-v1",
      "title": "Profile",
      "type": "string"
    },
    "provider_requests": {
      "const": 0,
      "default": 0,
      "title": "Provider Requests",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "submission_id": {
      "pattern": "^real_asset_submission_[0-9a-f]{20}$",
      "title": "Submission Id",
      "type": "string"
    },
    "template_id": {
      "pattern": "^real_asset_intake_template_[0-9a-f]{20}$",
      "title": "Template Id",
      "type": "string"
    }
  },
  "required": [
    "submission_id",
    "template_id",
    "items"
  ],
  "title": "CreativeSampleRealAssetSubmission",
  "type": "object"
}
