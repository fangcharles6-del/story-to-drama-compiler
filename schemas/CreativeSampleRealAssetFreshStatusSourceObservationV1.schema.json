  "required": [
    "observation_id",
    "subject_closure",
    "status_category",
    "claim_value",
    "source_kind",
    "source_identity_ref_sha256",
    "source_object_sha256",
    "source_object_size_bytes",
    "source_media_type",
    "source_event_at",
    "observed_at",
    "valid_from",
    "valid_until",
    "basis_code",
    "basis_note",
    "limitation_codes",
    "chain_link"
  ],
  "title": "CreativeSampleRealAssetFreshStatusSourceObservationV1",
  "type": "object"
}
