{
  "$defs": {
    "CharacterAssetVersion": {
      "additionalProperties": false,
      "description": "Portable, immutable reference to one approved character asset version.",
      "properties": {
        "approval_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Approval Ref",
          "type": "string"
        },
        "character_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Character Id",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "media_type": {
          "const": "image/png",
          "default": "image/png",
          "title": "Media Type",
          "type": "string"
        },
        "provenance": {
          "const": "IMPORTED_APPROVED_MEDIA",
          "default": "IMPORTED_APPROVED_MEDIA",
          "title": "Provenance",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "visual_description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Visual Description",
          "type": "string"
        }
      },
      "required": [
        "id",
        "character_id",
        "version",
        "content_sha256",
        "approval_ref",
        "visual_description"
      ],
      "title": "CharacterAssetVersion",
      "type": "object"
    },
    "CharacterBible": {
      "additionalProperties": false,
      "properties": {
        "active_asset_version_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Active Asset Version Id",
          "type": "string"
        },
        "asset_versions": {
          "items": {
            "$ref": "#/$defs/CharacterAssetVersion"
          },
          "minItems": 1,
          "title": "Asset Versions",
          "type": "array"
        },
        "character_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Character Id",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "visual_description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Visual Description",
          "type": "string"
        }
      },
      "required": [
        "character_id",
        "name",
        "visual_description",
        "asset_versions",
        "active_asset_version_id"
      ],
      "title": "CharacterBible",
      "type": "object"
    },
    "CreativeCameraAngle": {
      "enum": [
        "EYE_LEVEL",
        "LOW_ANGLE",
        "HIGH_ANGLE",
        "DUTCH_ANGLE",
        "OVERHEAD",
        "POV"
      ],
      "title": "CreativeCameraAngle",
      "type": "string"
    },
    "CreativeCameraMovement": {
      "enum": [
        "STATIC",
        "PAN",
        "TILT",
        "DOLLY",
        "TRUCK",
        "PEDESTAL",
        "HANDHELD",
        "CRANE",
        "ZOOM",
        "ORBIT"
      ],
      "title": "CreativeCameraMovement",
      "type": "string"
    },
    "CreativeSampleShotSpec": {
      "additionalProperties": false,
      "description": "ID-free source shot; compilation derives the immutable StoryboardShotV2 ID.",
      "properties": {
        "action": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "camera_angle": {
          "$ref": "#/$defs/CreativeCameraAngle"
        },
        "camera_movement": {
          "$ref": "#/$defs/CreativeCameraMovement"
        },
        "character_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "title": "Character Ids",
          "type": "array"
        },
        "continuity_notes": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Continuity Notes",
          "type": "string"
        },
        "dialogue_line_ids": {
          "items": {
            "type": "string"
          },
          "title": "Dialogue Line Ids",
          "type": "array"
        },
        "duration_ms": {
          "exclusiveMinimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "emotion_by_character": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 2,
          "title": "Emotion By Character",
          "type": "object"
        },
        "narrative": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Narrative",
          "type": "string"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "props": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Props",
          "type": "array"
        },
        "scene_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Scene Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "shot_size": {
          "$ref": "#/$defs/CreativeShotSize"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "visual_direction": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Visual Direction",
          "type": "string"
        },
        "wardrobe_by_character": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 2,
          "title": "Wardrobe By Character",
          "type": "object"
        }
      },
      "required": [
        "ordinal",
        "scene_id",
        "narrative",
        "visual_direction",
        "emotion_by_character",
        "action",
        "shot_size",
        "camera_angle",
        "camera_movement",
        "wardrobe_by_character",
        "props",
        "continuity_notes",
        "start_ms",
        "duration_ms",
        "character_ids",
        "dialogue_line_ids"
      ],
      "title": "CreativeSampleShotSpec",
      "type": "object"
    },
    "CreativeSampleSpec": {
      "additionalProperties": false,
      "description": "Portable, deterministic source for one 60-90 second creative sample.",
      "properties": {
        "character_bibles": {
          "items": {
            "$ref": "#/$defs/CharacterBible"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Character Bibles",
          "type": "array"
        },
        "dialogue": {
          "items": {
            "$ref": "#/$defs/DialogueLine"
          },
          "minItems": 1,
          "title": "Dialogue",
          "type": "array"
        },
        "duration_ms": {
          "maximum": 90000,
          "minimum": 60000,
          "title": "Duration Ms",
          "type": "integer"
        },
        "scene_bibles": {
          "items": {
            "$ref": "#/$defs/SceneBible"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Scene Bibles",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "shots": {
          "items": {
            "$ref": "#/$defs/CreativeSampleShotSpec"
          },
          "maxItems": 12,
          "minItems": 8,
          "title": "Shots",
          "type": "array"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "seed",
        "duration_ms",
        "character_bibles",
        "scene_bibles",
        "dialogue",
        "shots"
      ],
      "title": "CreativeSampleSpec",
      "type": "object"
    },
    "CreativeShotSize": {
      "enum": [
        "EXTREME_CLOSE_UP",
        "CLOSE_UP",
        "MEDIUM_CLOSE_UP",
        "MEDIUM",
        "MEDIUM_WIDE",
        "WIDE",
        "EXTREME_WIDE"
      ],
      "title": "CreativeShotSize",
      "type": "string"
    },
    "DialogueLine": {
      "additionalProperties": false,
      "properties": {
        "character_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Character Id",
          "type": "string"
        },
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "line_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Line Id",
          "type": "string"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "scene_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Scene Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "line_id",
        "ordinal",
        "scene_id",
        "character_id",
        "text",
        "start_ms",
        "end_ms"
      ],
      "title": "DialogueLine",
      "type": "object"
    },
    "SceneAssetVersion": {
      "additionalProperties": false,
      "description": "Portable, immutable reference to one approved scene asset version.",
      "properties": {
        "approval_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Approval Ref",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "media_type": {
          "const": "image/png",
          "default": "image/png",
          "title": "Media Type",
          "type": "string"
        },
        "provenance": {
          "const": "IMPORTED_APPROVED_MEDIA",
          "default": "IMPORTED_APPROVED_MEDIA",
          "title": "Provenance",
          "type": "string"
        },
        "scene_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Scene Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "visual_description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Visual Description",
          "type": "string"
        }
      },
      "required": [
        "id",
        "scene_id",
        "version",
        "content_sha256",
        "approval_ref",
        "visual_description"
      ],
      "title": "SceneAssetVersion",
      "type": "object"
    },
    "SceneBible": {
      "additionalProperties": false,
      "properties": {
        "active_asset_version_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Active Asset Version Id",
          "type": "string"
        },
        "asset_versions": {
          "items": {
            "$ref": "#/$defs/SceneAssetVersion"
          },
          "minItems": 1,
          "title": "Asset Versions",
          "type": "array"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "scene_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Scene Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "visual_description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Visual Description",
          "type": "string"
        }
      },
      "required": [
        "scene_id",
        "ordinal",
        "name",
        "visual_description",
        "asset_versions",
        "active_asset_version_id"
      ],
      "title": "SceneBible",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Fixture-only envelope that prevents the embedded spec being mistaken for real media.",
  "properties": {
    "document_type": {
      "const": "sdc.creative-sample-pilot-spec",
      "default": "sdc.creative-sample-pilot-spec",
      "title": "Document Type",
      "type": "string"
    },
    "eligible_for_real_generation": {
      "const": false,
      "default": false,
      "title": "Eligible For Real Generation",
      "type": "boolean"
    },
    "fixture_admission_scope": {
      "const": "TECHNICAL_COMPILATION_ONLY",
      "default": "TECHNICAL_COMPILATION_ONLY",
      "title": "Fixture Admission Scope",
      "type": "string"
    },
    "profile": {
      "const": "creative-sample-pilot-pack-v1",
      "default": "creative-sample-pilot-pack-v1",
      "title": "Profile",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_mode": {
      "const": "SYNTHETIC_PLACEHOLDER_ONLY",
      "default": "SYNTHETIC_PLACEHOLDER_ONLY",
      "title": "Source Mode",
      "type": "string"
    },
    "spec": {
      "$ref": "#/$defs/CreativeSampleSpec"
    }
  },
  "required": [
    "spec"
  ],
  "title": "CreativeSamplePilotSpecDocument",
  "type": "object"
}
