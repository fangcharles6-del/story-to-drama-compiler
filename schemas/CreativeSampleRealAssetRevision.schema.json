    "CharacterAssetBinding": {
      "additionalProperties": false,
      "properties": {
        "asset_version_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Asset Version Id",
          "type": "string"
        },
        "character_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Character Id",
          "type": "string"
        },
        "schema_version": {
          "const": "2.0.0",
