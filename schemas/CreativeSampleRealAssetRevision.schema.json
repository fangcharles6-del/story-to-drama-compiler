        "duration_ms": {
          "maximum": 90000,
          "minimum": 60000,
          "title": "Duration Ms",
          "type": "integer"
        },
        "scene_bibles": {
          "items": {
            "$ref": "#/$defs/SceneBible"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Scene Bibles",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "shots": {
          "items": {
            "$ref": "#/$defs/CreativeSampleShotSpec"
          },
          "maxItems": 12,
          "minItems": 8,
          "title": "Shots",
          "type": "array"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "seed",
        "duration_ms",
        "character_bibles",
