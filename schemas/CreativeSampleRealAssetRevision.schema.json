        "logical_path": {
          "title": "Logical Path",
          "type": "string"
        },
        "media_type": {
          "enum": [
            "image/png",
            "audio/wav"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "object_path": {
          "title": "Object Path",
          "type": "string"
        },
        "ordinal": {
          "maximum": 13,
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "provenance_record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Provenance Record Sha256",
          "type": "string"
        },
        "requirement_id": {
          "pattern": "^real_asset_requirement_[0-9a-f]{20}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "source_authority": {
          "enum": [
            "USER_PROVIDED_LOCAL",
            "SEPARATELY_APPROVED_LOCAL_GENERATION"
          ],
          "title": "Source Authority",
          "type": "string"
        },
        "subject_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Subject Id",
          "type": "string"
        },
        "technical_profile": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Technical Profile",
          "type": "string"
        },
        "technical_record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Technical Record Sha256",
          "type": "string"
        }
      },
      "required": [
        "ordinal",
        "requirement_id",
        "kind",
        "subject_id",
        "logical_path",
        "object_path",
        "media_type",
        "sha256",
        "size_bytes",
        "duration_ms",
        "source_authority",
        "provenance_record_sha256",
        "technical_profile",
        "technical_record_sha256"
      ],
