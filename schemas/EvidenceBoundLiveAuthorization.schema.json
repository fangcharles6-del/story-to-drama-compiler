{
  "additionalProperties": false,
  "description": "Inert one-POST authorization candidate bound to reviewed evidence and runtime policy.",
  "properties": {
    "attempt": {
      "const": 1,
      "default": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "authorization_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Authorization Id",
      "type": "string"
    },
    "authorized_at": {
      "format": "date-time",
      "title": "Authorized At",
      "type": "string"
    },
    "capability_snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Capability Snapshot Sha256",
      "type": "string"
    },
    "document_type": {
      "const": "sdc.evidence-bound-live-authorization",
      "default": "sdc.evidence-bound-live-authorization",
      "title": "Document Type",
      "type": "string"
    },
    "entitlement_anchor_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Entitlement Anchor Sha256",
      "type": "string"
    },
    "entitlement_valid_until": {
      "format": "date-time",
      "title": "Entitlement Valid Until",
      "type": "string"
    },
    "evidence_bundle_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Bundle Id",
      "type": "string"
    },
    "evidence_logical_tree_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Logical Tree Sha256",
      "type": "string"
    },
    "evidence_profile": {
      "const": "ark-canary-capability-pricing-v1",
      "default": "ark-canary-capability-pricing-v1",
      "title": "Evidence Profile",
      "type": "string"
    },
    "evidence_valid_until": {
      "format": "date-time",
      "title": "Evidence Valid Until",
      "type": "string"
    },
    "execution_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Sha256",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "job_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Job Id",
      "type": "string"
    },
    "ledger_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Ledger Id",
      "type": "string"
    },
    "max_cost_cny": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "maximum": 15.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Max Cost Cny"
    },
    "max_posts": {
      "const": 1,
      "default": 1,
      "title": "Max Posts",
      "type": "integer"
    },
    "nonce": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Nonce",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "pricing_snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Pricing Snapshot Sha256",
      "type": "string"
    },
    "provider_region": {
      "const": "cn-beijing",
      "default": "cn-beijing",
      "title": "Provider Region",
      "type": "string"
    },
    "request_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Fingerprint",
      "type": "string"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "runtime_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtime Policy Sha256",
      "type": "string"
    },
    "runtime_release_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtime Release Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "submission_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Submission Policy Sha256",
      "type": "string"
    },
    "task_queue": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Task Queue",
      "type": "string"
    },
    "worst_case_cost_cny": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Worst Case Cost Cny"
    }
  },
  "required": [
    "authorization_id",
    "plan_sha256",
    "execution_sha256",
    "submission_policy_sha256",
    "runtime_policy_sha256",
    "runtime_release_sha256",
    "evidence_bundle_id",
    "evidence_logical_tree_sha256",
    "evidence_valid_until",
    "entitlement_anchor_sha256",
    "entitlement_valid_until",
    "task_queue",
    "ledger_id",
    "run_id",
    "job_id",
    "request_fingerprint",
    "capability_snapshot_sha256",
    "pricing_snapshot_sha256",
    "worst_case_cost_cny",
    "max_cost_cny",
    "authorized_at",
    "expires_at",
    "nonce"
  ],
  "title": "EvidenceBoundLiveAuthorization",
  "type": "object"
}
